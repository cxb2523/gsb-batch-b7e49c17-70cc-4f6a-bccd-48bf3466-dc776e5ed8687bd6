{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": { "react-isokit": ["./src/index.ts"], "react-isokit/schema": ["./src/schema.ts"], "react-isokit/drafting": ["./src/drafting.ts"] },
    "types": ["vite/client", "node"]
  },
  "include": ["src", "test", "scripts", "examples/demo/src", "examples/demo/vite.config.ts", "tsdown.config.mjs", "vitest.config.ts"]
}
