    "maxStops": {
      "title": "Maximum stops",
      "type": "string",
      "description": "Largest number of stops allowed on any leg.",
      "editor": "select",
      "enum": [
        "any",
        "nonstop",
        "one_stop",
        "two_or_fewer"
      ],
      "enumTitles": [
        "Any",
        "Nonstop only",
        "One stop or fewer",
        "Two stops or fewer"
      ],
      "default": "any",
      "prefill": "any"
    },
    "airlines": {
      "title": "Only these airlines",
      "type": "array",
      "description": "Two-letter IATA airline codes to keep, e.g. [\"BA\",\"AA\"]. Flights marketed by or codesharing with these airlines are kept. Empty means all airlines.",
      "editor": "stringList",
      "default": [],
      "prefill": []
    },
    "excludeAirlines": {
      "title": "Exclude these airlines",
      "type": "array",
      "description": "Two-letter IATA airline codes to remove, e.g. [\"FR\"].",
      "editor": "stringList",
      "default": [],
      "prefill": []
    },
    "minPrice": {
      "title": "Minimum price",
      "type": "integer",
      "description": "Drop fares below this price, in the chosen currency.",
      "minimum": 0,
      "maximum": 100000
    },
    "maxPrice": {
      "title": "Maximum price",
      "type": "integer",
      "description": "Drop fares above this price, in the chosen currency.",
      "minimum": 0,
      "maximum": 100000
    },
    "maxDurationMinutes": {
      "title": "Maximum total duration (minutes)",
      "type": "integer",
      "description": "Drop itineraries longer than this, including layovers.",
      "minimum": 30,
      "maximum": 4320
    },
    "departureTimeRange": {
      "title": "Departure time",
      "type": "string",
      "description": "Only departures in this local-time window.",
      "editor": "select",
      "enum": [
        "any",
        "00-06",
        "06-12",
        "12-18",
        "18-24"
      ],
      "enumTitles": [
        "Any time",
        "00:00-06:00",
        "06:00-12:00",
        "12:00-18:00",
        "18:00-24:00"
      ],
      "default": "any",
      "prefill": "any"
    },
    "arrivalTimeRange": {
      "title": "Arrival time",
      "type": "string",
      "description": "Only arrivals in this local-time window.",
      "editor": "select",
      "enum": [
        "any",
        "00-06",
        "06-12",
        "12-18",
        "18-24"
      ],
      "enumTitles": [
        "Any time",
        "00:00-06:00",
        "06:00-12:00",
        "12:00-18:00",
        "18:00-24:00"
      ],
      "default": "any",
      "prefill": "any"
    },
    "lessEmissions": {
      "title": "Lower-emission flights only",
      "type": "boolean",
      "description": "Keep itineraries Google marks as producing less CO2 than typical for the route.",
      "default": false,
      "prefill": false
    },
    "sortBy": {
      "title": "Sort results by",
      "type": "string",
      "description": "How to order the returned flights.",
      "editor": "select",
      "enum": [
        "top",
        "cheapest",
        "fastest",
        "earliestDeparture",
        "latestDeparture",
        "lowestEmissions"
      ],
      "enumTitles": [
        "Google's top picks",
        "Cheapest first",
        "Fastest first",
        "Earliest departure",
        "Latest departure",
        "Lowest emissions"
      ],
      "default": "top",
      "prefill": "top"
    },
    "maxResults": {
      "title": "Maximum results",
      "type": "integer",
      "description": "Maximum number of flight or calendar rows to return; in calendar mode it also caps the number of days.",
      "minimum": 1,
      "maximum": 200,
      "default": 61,
      "prefill": 1
    },
    "returnOptionsTop": {
      "title": "Return options for top outbounds",
      "type": "integer",
      "description": "For round trips, fetch return flights for this many top outbound options. 0 turns this off.",
      "minimum": 0,
      "maximum": 20,
      "default": 0,
      "prefill": 0
    },
    "returnOptionsPerOutbound": {
      "title": "Return options per outbound",
      "type": "integer",
      "description": "How many return flights to attach to each selected outbound.",
      "minimum": 1,
      "maximum": 20,
      "default": 5,
      "prefill": 5
    },
    "includePriceInsights": {
      "title": "Include price insights",
      "type": "boolean",
      "description": "Add Google's current, typical and historical price range when available.",
      "default": true,
      "prefill": false
    },
    "priceGraphDays": {
      "title": "Price calendar days",
      "type": "integer",
      "description": "Number of calendar days to return in price-calendar mode (1-61), starting on the departure date; also capped by maxResults.",
      "minimum": 1,
      "maximum": 61,
      "default": 61,
      "prefill": 1
    },
    "priceAlertThreshold": {
      "title": "Price alert threshold",
      "type": "number",
      "description": "When set, add a priceBelowThreshold flag to every fare in the chosen currency.",
      "minimum": 0,
      "maximum": 100000
    },
    "searches": {
      "title": "Additional searches",
      "type": "array",
      "description": "Optional list of searches to run in one go. Each item needs originAirport, destinationAirport, outboundDate and an optional returnDate. Up to 20.",
      "editor": "json",
      "items": {
        "type": "object",
        "properties": {
          "originAirport": {
            "title": "Origin airport or city",
            "type": "string",
            "description": "Origin IATA airport or city code (one per search)."
          },
          "destinationAirport": {
            "title": "Destination airport or city",
            "type": "string",
            "description": "Destination IATA airport or city code (one per search)."
          },
          "outboundDate": {
            "title": "Departure date",
            "type": "string",
