{
  "title": "Google Flights Fare & Itinerary Filter Scraper Input",
  "description": "Search Google Flights by route and date. Choose one-way or round-trip, filter fares, fetch return options, or collect a price calendar.",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "mode": {
      "title": "Mode",
      "type": "string",
      "description": "Search flights, or collect the cheapest fare for each date around your departure date.",
      "editor": "select",
      "enum": [
        "search",
        "calendar"
      ],
      "enumTitles": [
        "Search flights",
        "Price calendar"
      ],
      "default": "search",
      "prefill": "search"
    },
    "originAirport": {
      "title": "Origin airport or city",
      "type": "string",
      "description": "Three-letter IATA airport or city code, e.g. JFK, LHR, NYC. One code per search; use `searches` for alternate airports.",
      "editor": "textfield",
      "default": "JFK",
      "prefill": "JFK"
    },
    "destinationAirport": {
      "title": "Destination airport or city",
      "type": "string",
      "description": "Three-letter IATA airport or city code, e.g. LHR, HND, LON. One code per search; use `searches` for alternate airports.",
      "editor": "textfield",
      "default": "LHR",
      "prefill": "LHR"
    },
    "outboundDate": {
      "title": "Departure date",
      "type": "string",
      "description": "Departure date in YYYY-MM-DD format. Leave empty to use 30 days from today (UTC); the chosen date is logged.",
      "editor": "textfield",
      "prefill": "2026-12-10"
    },
    "returnDate": {
      "title": "Return date",
      "type": "string",
      "description": "Return date in YYYY-MM-DD format. Leave empty for a one-way search.",
      "editor": "textfield"
    },
    "adults": {
      "title": "Adults",
      "type": "integer",
      "description": "Travellers aged 12 and over (1-9).",
      "minimum": 1,
      "maximum": 9,
      "default": 1,
      "prefill": 1
    },
    "children": {
      "title": "Children",
      "type": "integer",
      "description": "Travellers aged 2-11 (0-8).",
      "minimum": 0,
      "maximum": 8,
      "default": 0,
      "prefill": 0
    },
    "infants": {
      "title": "Infants on lap",
      "type": "integer",
      "description": "Infants under 2 travelling on an adult lap (0-8). Cannot exceed the number of adults.",
      "minimum": 0,
      "maximum": 8,
      "default": 0,
      "prefill": 0
    },
    "infantsInSeat": {
      "title": "Infants in a seat",
      "type": "integer",
      "description": "Infants under 2 travelling in their own seat (0-8).",
      "minimum": 0,
      "maximum": 8,
      "default": 0,
      "prefill": 0
    },
    "cabinClass": {
      "title": "Cabin class",
      "type": "string",
      "description": "Cabin to search.",
      "editor": "select",
      "enum": [
        "economy",
        "premium_economy",
        "business",
        "first"
      ],
      "enumTitles": [
        "Economy",
        "Premium economy",
        "Business",
        "First"
      ],
      "default": "economy",
      "prefill": "economy"
    },
