    "authorSlugs": {
      "title": "Author slugs",
      "type": "array",
      "description": "Filter by author slugs, e.g. jose, stephengraves. Author names are not accepted; use the slugs returned in each record.",
      "editor": "stringList",
      "default": [],
      "prefill": []
    },
    "articleIds": {
      "title": "Article IDs or URLs",
      "type": "array",
      "description": "Article IDs or decrypt.co URLs (mode=byId). Accepts bare IDs, /id/slug, localized /es/id/slug, ?p=id and /resources/slug URLs.",
      "editor": "stringList",
      "default": [],
      "prefill": [
        "375656"
      ]
    },
    "locale": {
      "title": "Language / locale",
      "type": "string",
      "description": "Article language. Leave empty to include every locale.",
      "editor": "select",
      "enum": [
        "",
        "en",
        "es",
        "fr",
        "ar",
        "zh-hans"
      ],
      "enumTitles": [
        "All languages",
        "English",
        "Spanish",
        "French",
        "Arabic",
        "Simplified Chinese"
      ],
      "default": "",
      "prefill": "en"
    },
    "dateRangeFrom": {
      "title": "Published from",
      "type": "string",
      "description": "Only articles published on or after this date (YYYY-MM-DD). The date range is applied by the source.",
      "editor": "datepicker"
    },
    "dateRangeTo": {
      "title": "Published until",
      "type": "string",
      "description": "Only articles published on or before this date (YYYY-MM-DD). The date range is applied by the source.",
      "editor": "datepicker"
    },
    "sortBy": {
      "title": "Sort order",
      "type": "string",
      "description": "Newest first, oldest first, or best match. Best match needs a search query; otherwise newest is used.",
      "editor": "select",
      "enum": [
        "newest",
        "oldest",
        "relevance"
      ],
      "enumTitles": [
        "Newest first",
        "Oldest first",
        "Best match"
      ],
      "default": "newest",
      "prefill": "newest"
    },
    "includeContent": {
      "title": "Include article body",
      "type": "boolean",
      "description": "Include full HTML and plain-text article bodies, TL;DR content and word count. Turn off for a lighter dataset.",
      "default": true,
      "prefill": true
    },
    "onlyNew": {
      "title": "Only new articles",
      "type": "boolean",
      "description": "Skip article IDs returned by earlier runs of this actor. Useful for scheduled monitoring. State is kept automatically.",
      "default": false,
      "prefill": false
    },
    "maxItems": {
      "title": "Max articles",
      "type": "integer",
      "description": "Maximum number of articles to return (1-10,000).",
      "minimum": 1,
      "maximum": 10000,
      "unit": "articles",
      "default": 10,
      "prefill": 1
    },
    "proxyConfiguration": {
      "title": "Proxy configuration",
      "type": "object",
      "description": "Optional. Leave off for a direct connection; the actor does not require a proxy.",
      "editor": "proxy",
      "prefill": {
        "useApifyProxy": false
      }
    }
  },
  "required": [
    "mode"
  ]
}
