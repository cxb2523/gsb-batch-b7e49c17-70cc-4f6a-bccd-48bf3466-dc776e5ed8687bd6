{
  "title": "Decrypt Crypto News Finder Input",
  "description": "Search Decrypt's crypto, Web3 and AI news archive by keyword, category, tag, coin, author or article ID. Date ranges and sort order run on the source.",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "mode": {
      "title": "Mode",
      "type": "string",
      "description": "What to fetch. Search matches titles, excerpts and article bodies. The latest mode returns the newest stories.",
      "editor": "select",
      "enum": [
        "search",
        "browseByCategory",
        "byId",
        "trending",
        "byTag",
        "byCoin",
        "byAuthor"
      ],
      "enumTitles": [
        "Search articles",
        "Browse a category",
        "Look up IDs or URLs",
        "Latest articles",
        "Browse a tag",
        "Browse a coin",
        "Browse an author"
      ],
      "default": "search",
      "prefill": "search"
    },
    "searchQuery": {
      "title": "Search query",
      "type": "string",
      "description": "Keyword or phrase matched against article titles, excerpts and bodies (mode=search). E.g. bitcoin, ethereum, NFT.",
      "editor": "textfield",
      "default": "",
      "prefill": "bitcoin"
    },
    "category": {
      "title": "Category",
