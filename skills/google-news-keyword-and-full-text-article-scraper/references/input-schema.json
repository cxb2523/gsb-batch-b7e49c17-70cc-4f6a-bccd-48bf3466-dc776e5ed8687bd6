    "dateRange": {
      "title": "Date range",
      "type": "string",
      "description": "Recency window. Every item is post-filtered by its real publication time, so items newer than the window never leak. 'custom' uses startDate/endDate. Multi-day ranges can be walked day by day to collect more than one feed page.",
      "editor": "select",
      "enum": [
        "any",
        "1h",
        "6h",
        "12h",
        "1d",
        "7d",
        "30d",
        "1y",
        "custom"
      ],
      "enumTitles": [
        "Any time",
        "Past hour",
        "Past 6 hours",
        "Past 12 hours",
        "Past day",
        "Past week",
        "Past 30 days",
        "Past year",
        "Custom dates"
      ],
      "default": "any",
      "prefill": "any"
    },
    "startDate": {
      "title": "Start date",
      "type": "string",
      "description": "Custom range start (YYYY-MM-DD, inclusive). Also used when dateRange=custom.",
      "editor": "textfield"
    },
    "endDate": {
      "title": "End date",
      "type": "string",
      "description": "Custom range end (YYYY-MM-DD, inclusive). Items published after the end are dropped client-side.",
      "editor": "textfield"
    },
    "maxResultsPerQuery": {
      "title": "Max results per query window",
      "type": "integer",
      "description": "Maximum records taken from each Google News feed request (1-100, Google's own cap is about 100). When a date range spans several days, the actor walks day windows and can collect more than 100 for one query, up to maxItems.",
      "default": 20,
      "minimum": 1,
      "maximum": 100,
      "prefill": 3
    },
    "maxItems": {
      "title": "Max items",
      "type": "integer",
      "description": "Hard cap on unique records emitted by the run (1-5000).",
      "default": 500,
      "minimum": 1,
      "maximum": 5000,
      "prefill": 3
    },
    "extractFullText": {
      "title": "Extract full text",
      "type": "boolean",
      "description": "Fetch each publisher page and extract its article body, description, author, and image. Default off for fast metadata-only runs. The articleUrls mode always extracts.",
      "default": false,
      "prefill": false
    },
    "maxFullText": {
      "title": "Max full-text extractions",
      "type": "integer",
      "description": "Maximum pages fetched for full text per run (1-500). Records beyond this cap are still returned with fullTextStatus=skipped_cap.",
      "default": 100,
      "minimum": 1,
      "maximum": 500,
      "prefill": 100
    },
    "proxyConfiguration": {
      "title": "Proxy configuration",
      "type": "object",
      "description": "Optional. No proxy is needed by default; Google News RSS and publisher pages work without one. Residential proxies can make Google rate-limit more, so leave this off unless you need it.",
      "editor": "proxy",
      "default": {
        "useApifyProxy": false
      },
      "prefill": {
        "useApifyProxy": false
      }
    }
  },
  "required": [
    "mode"
  ]
}
