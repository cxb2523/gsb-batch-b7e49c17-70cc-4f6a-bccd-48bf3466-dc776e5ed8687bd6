{
  "title": "Google News Scraper Input",
  "description": "Search Google News by keyword or browse topics, convert Google News URLs, read RSS feeds, or extract full text from article URLs.",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "mode": {
      "title": "Mode",
      "type": "string",
      "description": "What to scrape. Each mode reads its own list field below.",
      "editor": "select",
      "enum": [
        "keyword",
        "topic",
        "newsUrl",
        "rss",
        "articleUrls"
      ],
      "enumTitles": [
        "Keyword search",
        "Browse a topic",
        "Google News URL",
        "RSS / Atom feed",
        "Direct article URLs (full text)"
      ],
      "default": "keyword",
      "prefill": "keyword"
    },
    "queries": {
      "title": "Search queries (mode=keyword)",
      "type": "array",
      "description": "One or more keyword queries. Google operators such as site:, intitle: and OR are supported. Results are deduplicated across queries.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "default": [],
      "prefill": [
        "artificial intelligence"
      ]
    },
    "topics": {
      "title": "Topics (mode=topic)",
      "type": "array",
      "description": "Topic names (WORLD, NATION, BUSINESS, TECHNOLOGY, ENTERTAINMENT, SPORTS, SCIENCE, HEALTH), TOP for top stories, Google News topic hashes/section URLs, or topic URLs. Topic feeds ignore server-side date filters; results are filtered after download.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "default": [],
      "prefill": []
    },
    "newsUrls": {
      "title": "Google News URLs (mode=newsUrl)",
      "type": "array",
      "description": "Google News search URLs, topic URLs, RSS search/topic URLs, or RSS/Atom feed URLs to convert into a feed.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "default": [],
      "prefill": []
    },
    "rssUrls": {
      "title": "RSS / Atom feeds (mode=rss)",
      "type": "array",
      "description": "Any public RSS or Atom feed. Google News links inside the feed are resolved to publisher URLs automatically.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "default": [],
      "prefill": []
    },
    "articleUrls": {
      "title": "Article URLs (mode=articleUrls)",
      "type": "array",
      "description": "Publisher article URLs or Google News article URLs. Every page is fetched and full text is extracted, with a per-record status when a publisher blocks or paywalls it.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "default": [],
      "prefill": []
    },
    "language": {
