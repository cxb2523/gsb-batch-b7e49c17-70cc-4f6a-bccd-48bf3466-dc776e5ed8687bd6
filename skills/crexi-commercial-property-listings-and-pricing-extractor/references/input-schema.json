    "subtypes": {
      "title": "Property subtypes",
      "type": "array",
      "description": "Narrow to specific subtypes (e.g. Shopping Center, Medical Office, Warehouse). Note: some subtypes exist only for sale or only for lease listings.",
      "editor": "select",
      "uniqueItems": true,
      "default": [],
      "items": {
        "type": "string",
        "enum": [
          "Apartment Building",
          "Student Housing",
          "Single Family Rental Portfolio",
