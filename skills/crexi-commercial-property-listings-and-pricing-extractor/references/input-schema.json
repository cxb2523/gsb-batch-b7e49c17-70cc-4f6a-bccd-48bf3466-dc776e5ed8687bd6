    "cities": {
      "title": "Cities",
      "type": "array",
      "description": "City names to filter by (e.g. Austin). Works alongside or instead of states.",
      "editor": "stringList",
      "default": [],
      "prefill": []
    },
    "counties": {
      "title": "Counties",
      "type": "array",
      "description": "County names to filter by, including the word County where Crexi uses it (e.g. Travis County).",
      "editor": "stringList",
      "default": [],
      "prefill": []
    },
    "zipCodes": {
      "title": "ZIP codes",
      "type": "array",
      "description": "US ZIP codes to filter by (e.g. 78701).",
      "editor": "stringList",
      "default": [],
      "prefill": []
    },
    "minPrice": {
      "title": "Minimum asking price (USD)",
      "type": "integer",
      "description": "Only return listings asking at least this much. Sale and auction listings only.",
      "editor": "number",
      "minimum": 0,
      "nullable": true
    },
    "maxPrice": {
      "title": "Maximum asking price (USD)",
      "type": "integer",
      "description": "Only return listings asking at most this much. Sale and auction listings only.",
      "editor": "number",
      "minimum": 0,
      "nullable": true
    },
    "minPricePerSqft": {
      "title": "Minimum price per sq ft (USD)",
      "type": "number",
      "description": "Only return sale listings priced at or above this per square foot.",
      "editor": "number",
      "minimum": 0,
      "nullable": true
    },
    "maxPricePerSqft": {
      "title": "Maximum price per sq ft (USD)",
      "type": "number",
      "description": "Only return sale listings priced at or below this per square foot.",
      "editor": "number",
      "minimum": 0,
      "nullable": true
    },
    "minCapRate": {
      "title": "Minimum cap rate (%)",
      "type": "number",
      "description": "Only return sale listings with a published cap rate at or above this percentage.",
      "editor": "number",
      "minimum": 0,
      "maximum": 100,
      "nullable": true
    },
    "maxCapRate": {
      "title": "Maximum cap rate (%)",
      "type": "number",
      "description": "Only return sale listings with a published cap rate at or below this percentage.",
      "editor": "number",
      "minimum": 0,
      "maximum": 100,
      "nullable": true
    },
    "minSquareFootage": {
      "title": "Minimum building size (sq ft)",
      "type": "integer",
      "description": "Only return listings whose building is at least this large.",
      "editor": "number",
      "minimum": 1,
      "nullable": true
    },
    "maxSquareFootage": {
      "title": "Maximum building size (sq ft)",
      "type": "integer",
      "description": "Only return listings whose building is at most this large.",
      "editor": "number",
      "minimum": 1,
      "nullable": true
    },
    "minRatePerSqftAnnual": {
      "title": "Minimum lease rate ($/sq ft/year)",
      "type": "number",
      "description": "For-lease listings only: minimum annual rate per square foot.",
      "editor": "number",
      "minimum": 0,
      "nullable": true
    },
    "maxRatePerSqftAnnual": {
      "title": "Maximum lease rate ($/sq ft/year)",
      "type": "number",
      "description": "For-lease listings only: maximum annual rate per square foot.",
      "editor": "number",
      "minimum": 0,
      "nullable": true
    },
    "buildingClasses": {
      "title": "Building classes",
      "type": "array",
      "description": "Filter by commercial building class. Empty includes all classes.",
      "editor": "select",
      "uniqueItems": true,
      "default": [],
      "items": {
        "type": "string",
        "enum": [
          "A",
          "B",
          "C"
        ],
        "enumTitles": [
          "Class A",
          "Class B",
          "Class C"
        ]
      }
    },
    "opportunityZoneOnly": {
      "title": "Opportunity Zones only",
      "type": "boolean",
      "description": "Only return sale listings located in a designated Opportunity Zone.",
      "default": false,
      "prefill": false
    },
    "includeUnpriced": {
      "title": "Include listings without a price",
      "type": "boolean",
      "description": "Include sale and auction listings Crexi shows without a public asking price (auctions, call for offers).",
      "default": true,
      "prefill": true
    },
    "sortBy": {
      "title": "Sort by",
      "type": "string",
      "description": "Order of results within each search.",
      "editor": "select",
      "enum": [
        "Rank",
        "Price",
        "CapRate",
        "Noi",
        "UpdatedOn",
        "ActivatedOn",
        "CreatedOn"
      ],
      "enumTitles": [
        "Recommended (best match)",
        "Asking price",
        "Cap rate",
        "Net operating income",
        "Recently updated",
        "Recently listed",
        "Newest created"
      ],
      "default": "Rank",
      "prefill": "Rank"
    },
    "sortDirection": {
      "title": "Sort direction",
      "type": "string",
      "description": "Ascending or descending order for the sort chosen above.",
      "editor": "select",
      "enum": [
        "Descending",
        "Ascending"
      ],
      "enumTitles": [
        "Descending (high to low / newest first)",
        "Ascending (low to high)"
      ],
      "default": "Descending",
      "prefill": "Descending"
    },
    "scrapeDetails": {
      "title": "Enrich with full details",
      "type": "boolean",
      "description": "Fetch each listing's detail data: broker contacts (phone and email), the broker of record when published, the full photo gallery in high resolution, investment highlights, the marketing description, published fact-sheet values, and full auction details for auction listings. Adds a few requests per listing.",
      "default": false,
      "prefill": false
    },
    "includeSimilarProperties": {
      "title": "Include similar properties",
      "type": "boolean",
      "description": "Add up to 6 similar nearby listings (comps) to each record.",
      "default": false,
      "prefill": false
    },
    "maxProperties": {
      "title": "Maximum listings",
      "type": "integer",
      "description": "Stop once this many listings have been collected. Crexi returns at most 1,500 rows per filter combination; larger requests are automatically split into price-range partitions.",
      "default": 100,
      "prefill": 5,
      "minimum": 1,
      "maximum": 100000,
      "editor": "number"
    }
  },
  "required": []
}
