{
  "title": "Crexi Commercial Property Listings & Pricing Input",
  "description": "Search Crexi sale, lease and auction listings by keyword, location, property type, size, price, cap rate and more — or paste specific Crexi property or search URLs. No proxy, cookies or API keys needed.",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "propertyUrls": {
      "title": "Property or search URLs",
      "type": "array",
      "description": "Paste Crexi property links or IDs (e.g. https://www.crexi.com/properties/123456/name, /lease/properties/987/name, a bare ID, or a property-record link) to fetch those exact listings. A Crexi search URL (https://www.crexi.com/search/...) is also accepted and its filters are reused. Leave empty to search by the filters below.",
      "editor": "stringList",
      "default": [],
      "prefill": []
    },
    "transactionTypes": {
      "title": "Listing kind",
      "type": "array",
      "description": "Which Crexi marketplaces to search. Empty = for-sale listings only.",
      "editor": "select",
      "uniqueItems": true,
      "default": [],
      "items": {
        "type": "string",
        "enum": [
          "sale",
          "lease",
          "auction"
        ],
        "enumTitles": [
          "For sale",
          "For lease",
          "Auctions"
        ]
      }
    },
    "searchTerms": {
      "title": "Keywords",
      "type": "array",
      "description": "Free-text keywords matched against listing names, descriptions and addresses (e.g. warehouse, medical office).",
      "editor": "stringList",
      "default": [],
      "prefill": []
    },
    "propertyTypes": {
      "title": "Property types",
      "type": "array",
      "description": "One or more commercial property categories. Empty searches every type.",
      "editor": "select",
      "uniqueItems": true,
      "default": [],
      "items": {
        "type": "string",
        "enum": [
          "Office",
          "Retail",
          "Industrial",
          "Multifamily",
          "Land",
          "Hospitality",
          "Mixed Use",
          "Special Purpose",
          "Self Storage",
          "Mobile Home Park",
          "Senior Living",
          "Business for Sale",
          "Note/Loan",
          "Restaurant"
        ],
        "enumTitles": [
          "Office",
          "Retail",
          "Industrial",
          "Multifamily",
          "Land",
