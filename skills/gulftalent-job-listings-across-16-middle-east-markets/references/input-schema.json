    "employmentTypes": {
      "title": "Employment types",
      "type": "array",
      "description": "Any of: full-time, part-time, contract, temporary, internship. Leave empty for all types.",
      "editor": "stringList",
      "default": [],
      "prefill": []
    },
    "nationality": {
      "title": "Nationality preference",
      "type": "string",
      "description": "Only jobs aimed at this Gulf nationality.",
      "editor": "select",
      "enum": [
        "",
        "uae",
        "saudi",
        "kuwaiti",
        "qatari",
        "bahraini",
        "omani"
      ],
      "enumTitles": [
        "Any nationality",
        "UAE",
        "Saudi Arabia",
        "Kuwait",
        "Qatar",
        "Bahrain",
        "Oman"
      ],
      "default": "",
      "prefill": ""
    },
    "remoteOnly": {
      "title": "Remote jobs only",
      "type": "boolean",
      "description": "Keep only postings GulfTalent flags as remote.",
      "default": false,
      "prefill": false
    },
    "easyApplyOnly": {
      "title": "Easy Apply only",
      "type": "boolean",
      "description": "Keep only jobs that can be applied for on GulfTalent.",
      "default": false,
      "prefill": false
    },
    "exclusiveOnly": {
      "title": "Exclusive jobs only",
      "type": "boolean",
      "description": "Keep only GulfTalent-exclusive postings.",
      "default": false,
      "prefill": false
    },
    "postedWithinDays": {
      "title": "Posted within (days)",
      "type": "integer",
      "description": "Only jobs posted in the last N days. 0 means any age.",
      "minimum": 0,
      "maximum": 90,
      "default": 0,
      "prefill": 0
    },
    "includeKeywords": {
      "title": "Must contain keywords",
      "type": "array",
      "description": "Keep only jobs whose title, description or job function contains any of these terms (case-insensitive).",
      "editor": "stringList",
      "default": [],
      "prefill": []
    },
    "excludeKeywords": {
      "title": "Exclude keywords",
      "type": "array",
      "description": "Drop jobs whose title, description or job function contains any of these terms (case-insensitive).",
      "editor": "stringList",
      "default": [],
      "prefill": []
    },
    "minSalary": {
      "title": "Minimum salary",
      "type": "integer",
      "description": "Drop jobs below this salary in the job's own currency. Jobs without a disclosed salary are kept.",
      "minimum": 0,
      "maximum": 10000000
    },
    "maxSalary": {
      "title": "Maximum salary",
      "type": "integer",
      "description": "Drop jobs above this salary in the job's own currency. Jobs without a disclosed salary are kept.",
      "minimum": 0,
      "maximum": 10000000
    },
    "fetchFullDetails": {
      "title": "Fetch full details",
      "type": "boolean",
      "description": "Visit each job page for the full description, salary, address and preference fields. Turn off for the fastest, cheapest listing-only runs.",
      "default": true,
      "prefill": false
    },
    "maxItems": {
      "title": "Max records",
      "type": "integer",
      "description": "Hard cap on emitted records (1-10000).",
      "minimum": 1,
      "maximum": 10000,
      "default": 25,
      "prefill": 3
    },
    "companyUrl": {
      "title": "Company careers URL or slug (mode=byCompany)",
      "type": "string",
      "description": "A GulfTalent company page such as https://www.gulftalent.com/companies/marriott-international-careers or just marriott-international-careers.",
      "editor": "textfield",
      "default": "",
      "prefill": ""
    },
    "startUrls": {
      "title": "Start URLs (mode=byUrls)",
      "type": "array",
      "description": "Job detail URLs, search/listing URLs or company careers URLs.",
      "editor": "stringList",
      "default": [],
      "prefill": []
    },
    "salaryTitles": {
      "title": "Salary titles (mode=salary)",
      "type": "array",
      "description": "Job titles to benchmark, e.g. accountant or project manager.",
      "editor": "stringList",
      "default": [
        "accountant"
      ],
      "prefill": [
        "accountant"
      ]
    },
    "salaryCountry": {
      "title": "Salary country (mode=salary)",
