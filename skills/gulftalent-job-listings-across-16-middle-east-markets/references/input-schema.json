{
  "title": "GulfTalent Jobs & Salary Benchmarks Input",
  "description": "Search live GulfTalent jobs across 38 markets, pull an employer's careers page or specific URLs, and export salary benchmarks. No login, cookies, or API key required.",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "mode": {
      "title": "Mode",
      "type": "string",
      "description": "What to collect: job search, one employer, pasted URLs, or salary benchmarks.",
      "editor": "select",
      "enum": [
        "search",
        "byCompany",
        "byUrls",
        "salary"
      ],
      "enumTitles": [
        "Search jobs",
        "One company's careers page",
        "Pasted job / search / company URLs",
        "Salary benchmarks"
      ],
      "default": "search",
      "prefill": "search"
    },
    "searchQueries": {
      "title": "Search keywords (mode=search)",
      "type": "array",
      "description": "One or more job-title keywords. Each query is paginated in full and results are de-duplicated. Leave empty to browse all jobs that match the filters.",
      "editor": "stringList",
      "default": [
        "accountant"
      ],
      "prefill": [
        "accountant"
      ]
    },
