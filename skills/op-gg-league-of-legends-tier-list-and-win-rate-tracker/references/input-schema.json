{
  "title": "OP.GG Scraper Input",
  "description": "Scrape OP.GG League of Legends champion tier lists, win rates, counters, and champion statistics by region, rank, queue, lane, and patch.",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "mode": {
      "title": "Mode",
      "type": "string",
      "description": "What to fetch: a champion tier list, champion statistics, or every matchup for selected champions. `byPosition` is a legacy alias for a position-scoped tier list.",
      "editor": "select",
      "enum": [
        "tierList",
        "championStats",
        "fullCounters",
        "byPosition"
      ],
      "enumTitles": [
        "Champion tier list (win/pick/ban rates, counters, rank movement)",
        "Champion statistics (games, KDA, CS, gold)",
        "Full counters (every matchup for selected champions)",
        "By position (legacy alias)"
      ],
      "default": "tierList",
      "prefill": "tierList"
    },
    "queueType": {
      "title": "Queue",
      "type": "string",
      "description": "Queue to read. Classic applies to tierList and fullCounters; ARAM applies to championStats.",
      "editor": "select",
      "enum": [
        "ranked",
        "flex",
        "classic",
        "aram"
      ],
      "enumTitles": [
        "Ranked Solo/Duo",
        "Ranked Flex",
        "Classic (tierList only)",
        "ARAM (championStats only)"
      ],
      "default": "ranked",
      "prefill": "ranked"
    },
    "region": {
      "title": "Region",
      "type": "string",
      "description": "Server to read. Global combines every server OP.GG tracks.",
      "editor": "select",
      "enum": [
        "global",
        "na",
        "me",
        "euw",
        "eune",
        "oce",
        "kr",
        "jp",
        "br",
        "las",
        "lan",
        "ru",
        "tr",
        "sea",
        "tw",
        "vn"
      ],
      "enumTitles": [
        "All Servers (Global)",
        "North America (NA)",
        "Middle East (ME)",
        "Europe West (EUW)",
        "Europe Nordic & East (EUNE)",
        "Oceania (OCE)",
        "Korea (KR)",
        "Japan (JP)",
        "Brazil (BR)",
        "Latin America South (LAS)",
        "Latin America North (LAN)",
        "Russia (RU)",
        "Türkiye (TR)",
        "Southeast Asia (SEA)",
        "Taiwan (TW)",
        "Vietnam (VN)"
      ],
      "default": "global",
      "prefill": "global"
    },
    "rankTier": {
      "title": "Player rank",
      "type": "string",
      "description": "Only include games from this rank. Champion stats mode uses the base tier for plus tiers (e.g. Emerald+ → Emerald).",
      "editor": "select",
      "enum": [
        "all",
        "challenger",
        "grandmaster",
        "master_plus",
        "master",
        "diamond_plus",
        "diamond",
        "emerald_plus",
        "emerald",
        "platinum_plus",
        "platinum",
        "gold_plus",
        "gold",
        "silver",
        "bronze",
        "iron"
      ],
      "enumTitles": [
        "All tiers",
        "Challenger",
        "Grandmaster",
        "Master +",
        "Master",
        "Diamond +",
        "Diamond",
        "Emerald +",
        "Emerald",
        "Platinum +",
        "Platinum",
        "Gold +",
        "Gold",
        "Silver",
        "Bronze",
        "Iron"
      ],
      "default": "emerald_plus",
      "prefill": "emerald_plus"
    },
    "position": {
      "title": "Position",
      "type": "string",
      "description": "Lane to read. ALL returns every lane; in fullCounters it uses each champion's primary lane.",
      "editor": "select",
      "enum": [
        "ALL",
        "TOP",
        "JUNGLE",
        "MID",
        "ADC",
        "SUPPORT"
      ],
      "enumTitles": [
        "All positions",
        "Top",
        "Jungle",
        "Mid",
        "ADC / Bot",
        "Support"
      ],
      "default": "ALL",
      "prefill": "ALL"
    },
    "champions": {
      "title": "Champions",
      "type": "array",
      "description": "Champion names, keys, or OP.GG build URLs to fetch every matchup for (mode=fullCounters). Example: Ahri, jinx, https://op.gg/lol/champions/ahri/build/mid.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "prefill": []
    },
    "patch": {
      "title": "Patch",
      "type": "string",
      "description": "Tier-list and fullCounter patch. OP.GG keeps the latest and previous patch; Classic has no patch history.",
      "editor": "select",
      "enum": [
        "latest",
        "previous"
      ],
      "enumTitles": [
        "Latest patch",
        "Previous patch"
      ],
      "default": "latest",
      "prefill": "latest"
    },
    "minTier": {
      "title": "Minimum champion tier",
      "type": "string",
      "description": "Tier-list cutoff. OP is the strongest, then 1 through 5. Lower numbers keep stronger champions.",
      "editor": "select",
      "enum": [
        "all",
        "0",
        "1",
        "2",
        "3",
        "4",
        "5"
      ],
      "enumTitles": [
        "All tiers",
        "OP tier",
        "1 tier",
        "2 tier",
        "3 tier",
        "4 tier",
        "5 tier"
      ],
      "default": "all",
      "prefill": "all"
    },
    "period": {
      "title": "Stats period",
      "type": "string",
      "description": "Time window for champion statistics (mode=championStats).",
      "editor": "select",
      "enum": [
        "month",
        "week",
        "day"
      ],
      "enumTitles": [
        "Last month",
        "Last 7 days",
        "Today"
      ],
      "default": "month",
      "prefill": "month"
    },
    "maxItems": {
      "title": "Max items",
      "type": "integer",
      "description": "Hard cap on emitted records. OP.GG returns at most 271 tier rows or 173 stat rows per filter.",
      "minimum": 1,
      "maximum": 1000,
      "default": 100,
      "prefill": 20
    }
  },
  "required": [
    "mode"
  ]
}
